doctype html
html(lang="en")
  head
    title Arbesk — Describe it. Keep every version.
    meta(charset="utf-8")
    meta(name="viewport", content="width=device-width, initial-scale=1")
    meta(name="description", content="Generate 3D models and CAD parts from a sentence. Every edit after that is saved as a version you can return to.")
    meta(property="og:title", content="Arbesk — Describe it. Keep every version.")
    meta(property="og:description", content="Generate 3D models and CAD parts from a sentence. Every edit after that is saved, forever.")
    meta(property="og:type", content="website")
    meta(property="og:site_name", content="Arbesk")
    meta(name="twitter:card", content="summary_large_image")
    //- TODO: add og:image, og:url, and rel=canonical once the production
    //- domain is fixed — those tags require absolute URLs.
    link(rel="icon", type="image/webp", href="/logo.webp")
    link(rel="apple-touch-icon", href="/apple-touch-icon.webp")
    link(rel="stylesheet", href="/css/styles.css")
    link(rel="preload", href="/fonts/inter-latin-wght-normal.woff2", as="font", type="font/woff2", crossorigin)
    script(src="/js/engine/theme-init.js")
    script(src="/js/landing/landing.js", defer)

  body.landing-page
    #app
      #testnetBanner.testnet-banner(role="status") Testnet — Base Sepolia. Assets created here are not on mainnet.
      header.landing-header
        a.landing-brand(href="/", aria-label="Arbesk home")
          img(src="/brand-logo.webp", alt="", width="78", height="52")
          span Arbesk
        a.landing-link(href="/library?login=1") Sign in

      main
        section.landing-hero
          h1
            | Describe it.
            br
            span.landing-hero-dim Keep every version.
          p.landing-hero-sub Generate 3D models and CAD parts from a sentence. Every edit after that is saved, forever.
          .landing-composer
            form#prompt.prompt(method="get", action="/studio")
              fieldset.prompt-mode
                legend.sr-only Model type
                label
                  input(type="radio", name="provider", value="cad", checked)
                  span CAD
                label
                  input(type="radio", name="provider", value="tripo3d")
                  span 3D
              input#promptText.prompt-input(type="text", name="prompt", maxlength="500", required, autocomplete="off", placeholder="Describe a part…", aria-label="Describe your model")
              button.landing-cta(type="submit") Generate
            #promptChips.prompt-chips
            p#promptNote.prompt-note CAD parts work out of the box — no API key needed.
          a.landing-upload(href="/library?upload=1")
            span.landing-upload-icon
              svg(width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true")
                use(href="/icons.svg#upload")
            span.landing-upload-text
              strong Upload your model
              span GLB, glTF or 3MF — every edit after that is kept as a version.
            span.landing-upload-history.tabular(aria-hidden="true")
              span v1
              i
              span v2
              i
              span v3

        section#cad.landing-track.landing-track-cad(aria-labelledby="cadTitle", data-cad-only)
          .landing-track-copy
            span.landing-track-kicker For makers
            h2#cadTitle Parts that fit.
            p Describe a bracket, a stand or a storage bin with real dimensions. You get a precise part, ready to print.
            ul.landing-track-facts
              li Dimensions in millimetres
              li Exports 3MF for your slicer
              li Rendered right in your browser
              li No API key needed
            .landing-track-try
              span Try
              a.landing-link(href="/studio?provider=cad&prompt=M3%20mounting%20bracket%2C%2040%20mm") M3 mounting bracket, 40 mm
              a.landing-link(href="/studio?provider=cad&prompt=Gridfinity%20bin%202%C3%973") Gridfinity bin 2×3
          figure.landing-blueprint(aria-hidden="true")
            .landing-blueprint-part
            .landing-blueprint-dims
            span.landing-dim.landing-dim-length.tabular 40
            span.landing-dim.landing-dim-width.tabular 24
            span.landing-dim.landing-dim-height.tabular 30
            figcaption.tabular L-bracket · 40 × 24 × 30 mm · 3 mm wall

        section#art.landing-track.landing-track-art(aria-labelledby="artTitle")
          .landing-gallery
            img(src="/landing/asset-reema.webp", alt="Reema, a character in an embroidered dress and keffiyeh", width="900", height="900", loading="lazy")
            img(src="/landing/asset-suka.webp", alt="Suka, a round creature with a woven straw hat", width="900", height="900", loading="lazy")
          .landing-track-copy
            span.landing-track-kicker For artists
            h2#artTitle Characters with character.
            p Characters, creatures and props from a sentence or a sketch. Then keep shaping them, one version at a time.
            ul.landing-track-facts
              li Text or up to four reference views
              li Retexture and retopologize
              li Rig and animate
            p.landing-track-note Uses your own #[a.landing-link(href="https://platform.tripo3d.ai/", rel="noopener") Tripo 3D API key] — add it once in the Studio.
            .landing-track-try
              span Try
              a.landing-link(href="/studio?provider=tripo3d&prompt=Low-poly%20fox") Low-poly fox
              a.landing-link(href="/studio?provider=tripo3d&prompt=Cowboy%20mascot") Cowboy mascot

        section.landing-demo(aria-labelledby="demoTitle")
          .landing-demo-head
            h2#demoTitle The world is 4D.
            p Time is the fourth dimension. Step back through everything this model has been.
          figure#versionDemo.landing-demo-figure
            .landing-demo-stage
              img.landing-demo-fallback(src="/landing/asset-howdy.webp", alt="Howdy, a cowboy character made in Arbesk")
              canvas(role="img" aria-label="Live 3D model — drag to rotate")
            .landing-demo-rail
              #versionRail.version-rail(role="group", aria-label="Versions")
              p#versionCaption.version-caption(aria-live="polite")

        section.landing-pillars(aria-label="How it works")
          div
            span.landing-pillar-n 01
            h3 Generate
            p Precise CAD parts or characters and props — from text or a reference image.
          div
            span.landing-pillar-n 02
            h3 Version
            p Every change is a version. Nothing is overwritten, nothing is lost.
          div
            span.landing-pillar-n 03
            h3 Share
            p Invite editors, comment on any asset, and publish when it’s ready.

      footer.landing-footer
        .landing-final
          div
            h2 Start with a sentence.
            p Sign in with an email code. No password.
          a.landing-cta(href="#prompt") Generate a model
        .landing-base
          span Arbesk — from #[em arabesque]
          nav(aria-label="Footer")
            a.landing-link(href="/library") Library
            a.landing-link(href="/studio") Studio
