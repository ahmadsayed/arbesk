//- Sidebar reveal button
button#sidebarReveal.sidebar-reveal(aria-label="Show sidebar" title="Show sidebar (Ctrl+B)")
  svg(width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" aria-hidden="true")
    use(href="/icons.svg#chevron-right")

//- Main content area
main#mainStage.main-stage
  #viewport.viewport
    canvas#renderCanvas(aria-label="3D viewport" role="img")
    canvas#viewportGizmo(aria-label="Viewport orientation gizmo" title="X Y Z orientation")

    #taskProgress.task-progress(hidden aria-hidden="true")
      span#taskProgressLabel.task-progress-label
      .task-progress-track
        #taskProgressFill.task-progress-fill

    #assetDropOverlay.viewport-drop-indicator
      div(style="position:absolute;inset:0;display:flex;align-items:center;justify-content:center;color:var(--accent-bg);font-weight:600")
        .asset-drop-icon ⊕
        p Drop to add linked asset to scene

//- Inspector — right sidebar (open by default; user collapses via toggle)
aside#inspector.inspector
  .inspector-header
    h3 Properties
  .inspector-body
    section#tokenChildInfo.inspector-section.inspector-token-child(hidden)
      details
        summary.inspector-section-title Token Info
        div
          .inspector-meta
            .inspector-meta-row
              span.label Linked Token
              span#tokenChildId.value —
            .inspector-meta-row
              span.label Contract
              span#tokenChildContract.value —
            .inspector-meta-row
              span.label Chain ID
              span#tokenChildChain.value —
            .inspector-meta-row
              span.label Resolution
              span#tokenChildResolution.value latest
            .inspector-meta-row
              span.label Manifest CID
              span#tokenChildCid.value(style="font-family:var(--font-mono);font-size:var(--font-size-0);word-break:break-all") —
          .inspector-actions
            button#inspectorDiveBtn.btn.btn-primary(style="width:100%") Open Asset &rarr;
    section#scaleSection.inspector-section.inspector-scale(hidden)
      details
        summary.inspector-section-title Scale
        div
          .inspector-transform
            .inspector-transform-row
              label(for="nodeScaleFactor") Factor
              input#nodeScaleFactor.form-input(type="number" min="0.01" step="0.1" value="1" aria-label="Uniform scale factor")
            .inspector-transform-row
              label(for="nodeScalePercent") Percent
              input#nodeScalePercent.form-input(type="number" min="1" step="1" value="100" aria-label="Uniform scale percentage")
          p.inspector-hint Applies the same scale on all axes — enter the same value on each copy to make them identical in size.
    section#animationsSection.inspector-section.inspector-animations(hidden)
      details
        summary.inspector-section-title Animations
        div
          select#animationSelect.form-select(aria-label="Animation clip")
            option(value="") None
    section#parametricEditor.inspector-section
      details
        summary.inspector-section-title Color
        div
          #componentEditor(hidden)
            .component-editor-header
              span#selectedComponentName.component-editor-name —
              .component-editor-swatch#selectedComponentSwatch
            input#selectedComponentColor.form-color.component-color-editor(type="color" aria-label="Component color")
    section#metadataSection.inspector-section.metadata-section(hidden)
      details(open)
        summary.inspector-section-title Metadata
        div
          .metadata-computed
            h6.metadata-block-title Auto-detected
            dl#metadataComputedList.metadata-list
          .metadata-annotations
            h6.metadata-block-title Notes for the AI
            #metadataAnnotationsList.metadata-kv
            .metadata-actions
              button#metadataAddBtn.btn.btn-secondary.btn-sm(type="button") + Add field
            .metadata-quick-add
              span.metadata-quick-label Quick add:
              button.metadata-chip(type="button" data-key="character_name") character_name
              button.metadata-chip(type="button" data-key="role") role
              button.metadata-chip(type="button" data-key="species") species
              button.metadata-chip(type="button" data-key="tags") tags
              button.metadata-chip(type="button" data-key="lore") lore
              button.metadata-chip(type="button" data-key="pivot") pivot
    section#commentsSection.inspector-section.comments-section(hidden x-data="commentsPanel" :hidden="!sectionVisible")
      h3#commentsTitle.inspector-section-title Comments ·
        span#commentsCount(x-text="count") 0
      .comments-scroll
        ul#commentList.comment-list(role="list" aria-label="Comments")
          template(x-for="c in comments" :key="c.id")
            li.comment-item(:class="{ 'comment-mentioned-you': c.mentioned }" :data-event-id="c.id")
              .comment-avatar(aria-hidden="true" x-text="c.avatar")
              .comment-body
                .comment-meta
                  span.comment-author(:title="c.authorTitle" x-text="c.author")
                  span.comment-time(x-text="c.time")
                p.comment-text(x-html="c.html")
      #commentsEmpty.comments-empty(:hidden="!showEmpty")
        .comments-empty-icon ✦
        p.comments-empty-title(x-text="emptyTitle") No comments yet
        p.comments-empty-sub(x-text="emptySub") Mention an editor to request a change or review.
      .comment-composer
        #commentAutocomplete.autocomplete(hidden role="listbox" aria-label="Mention a wallet")
        label.composer-label(for="commentComposerInput") Add a comment
        textarea#commentComposerInput.composer-input(rows="3" placeholder="Add a comment… use @ to mention a wallet." aria-label="Add a comment" x-model="draft" @keydown.ctrl.enter.prevent="post()")
        .composer-actions
          span.composer-hint Ctrl+Enter to send
          button#postCommentBtn.btn.btn-primary.btn-sm(type="button" aria-label="Post comment" title="Post comment (Ctrl+Enter)" :disabled="!canPost" @click="post()") Post
      span#commentsLiveRegion.sr-only(aria-live="polite" aria-atomic="true")
  .inspector-footer
    button#inspectorToggle.panel-toggle(aria-label="Collapse inspector" title="Collapse inspector" aria-expanded="true")
      svg(width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" aria-hidden="true")
        use(href="/icons.svg#chevron-right")
button#inspectorReveal.inspector-reveal(aria-label="Show inspector" title="Show inspector")
  svg(width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" aria-hidden="true")
    use(href="/icons.svg#chevron-left")
