doctype html
html(lang="en")
  head
    include includes/head.pug
  body
    #app
      header.headerbar
        include includes/header.pug
      //- ═══════════════════════════════════════════════════════════
      //- Studio view
      //- ═══════════════════════════════════════════════════════════
      main#studioView.app-view
        .studio-layout
          //- Unified Sidebar with View Switcher
          aside.sidebar#sidebar
            include includes/studio-sidebar.pug
          include includes/studio-main.pug
        include includes/bottombar.pug
      //- ═══════════════════════════════════════════════════════════
      //- Library view
      //- ═══════════════════════════════════════════════════════════
      main#libraryView.app-view.hidden
        include includes/library-view.pug
      include includes/wallet-popover.pug
    include includes/dialog-host.pug
    script(type="module", src="/js/app.js")
