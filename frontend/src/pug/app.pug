doctype html
html(lang="en")
  head
    title Arbesk
    meta(charset="utf-8")

    meta(name="viewport", content="width=device-width, initial-scale=1")
    link(rel="icon", type="image/webp", href="/logo.webp")
    link(rel="apple-touch-icon", href="/apple-touch-icon.webp")
    link(rel="stylesheet", href="/css/styles.css")
    script(src="/js/engine/theme-init.js")
    script(src="/js/app/initial-view.js")
    //- All classic CDN scripts are deferred: our own code is type="module"
    //- (defer-by-definition) and deferred classic scripts run before module
    //- scripts in document order, so globals are ready without blocking paint.
    script(src="https://cdn.jsdelivr.net/npm/notyf@3.10.0/notyf.min.js" crossorigin="anonymous" defer)
    script(src="https://cdn.jsdelivr.net/npm/tabbable@6.2.0/dist/index.umd.min.js" crossorigin="anonymous" defer)
    script(src="https://cdn.jsdelivr.net/npm/focus-trap@7.6.2/dist/focus-trap.umd.min.js" crossorigin="anonymous" defer)
    //- Babylon.js is NOT loaded here — it is fetched lazily on first Studio
    //- entry by js/engine/babylon-loader.js, so the Library view and the
    //- sign-in modal boot without waiting for a 3D engine they never use.
    script(src="https://cdn.jsdelivr.net/npm/web3@1.10.0/dist/web3.min.js" crossorigin="anonymous" defer)
    script(type="importmap").
      {
        "imports": {
          "@gltf-transform/core": "/js/vendor/gltf-transform-core-4.1.2.js",
          "fflate": "https://esm.sh/fflate@0.8.2",
          "alpinejs": "https://esm.sh/alpinejs@3.16.1",
          "fast-xml-parser": "https://esm.sh/fast-xml-parser@4.5.3",
          "@openzeppelin/merkle-tree": "https://esm.sh/@openzeppelin/merkle-tree@1.0.8",
          "@coinbase/cdp-core": "https://esm.sh/@coinbase/cdp-core@0.0.113?bundle"
        }
      }
  body
    #app
      header.headerbar
        h1.sr-only Arbesk
        .headerbar-brand
          img.logo-light(src="/logo.webp", alt="Arbesk")
          img.logo-dark(src="/logo-dark.webp", alt="Arbesk")

        nav.page-switcher(aria-label="Page")
          a.page-switcher-tab(href="/library" data-nav) Library
          a.page-switcher-tab.active(href="/studio" data-nav) Studio

        button#backBtn.headerbar-back.hidden(aria-label="Go back to parent asset", title="Go back (Alt+Left)")
          svg(width="19" height="19" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true")
            use(href="/icons.svg#chevron-left")

        .headerbar-title
          nav#pathBar.pathbar.hidden(aria-label="Asset path")
          span#assetStatusName.headerbar-title-text(aria-label="Asset name") No asset open
          span#assetStatusMeta.headerbar-title-meta Create or open an asset

        .headerbar-divider(aria-hidden="true")
        .headerbar-doc-actions
          button#newAssetBtn.btn.btn-secondary(type="button" aria-label="New asset" title="New asset (Ctrl+N)")
            svg(width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true")
              use(href="/icons.svg#plus")
            span New
          button#saveAssetBtn.btn.btn-secondary(hidden type="button" aria-label="Save Draft" title="Save Draft (Ctrl+S)")
            svg(width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true")
              use(href="/icons.svg#save")
            span#saveAssetBtnText Save
          button#publishAssetBtn.btn.btn-primary(hidden type="button" aria-label="Publish asset" title="Publish (Besk it) this asset")
            svg.besk-it-logo(width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true")
              use(href="/icons.svg#besk-star")
            span#publishAssetBtnText Besk it
          button#downloadAssetBtn.btn.btn-icon.btn-flat(hidden type="button" aria-label="Download model file" title="Download the model file (GLB/glTF)")
            svg(width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true")
              use(href="/icons.svg#download")

        .headerbar-actions(x-data="headerWallet")
          button#themeToggle.btn.btn-icon.btn-flat(aria-label="Toggle theme" title="Toggle theme")
            svg.theme-icon-light(width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true")
              use(href="/icons.svg#sun")
            svg.theme-icon-dark(width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true")
              use(href="/icons.svg#moon")
          select#headerbarNetworkSelect.headerbar-network-select(:class="{ connected: connected && !isCdp, hidden: isCdp }" aria-label="Select network" title="Select network")
            option(value="baseSepolia" selected) Base Sepolia Testnet
            option(value="hardhat") Hardhat Local
          button#connectWalletBtn.headerbar-wallet.disconnected(:class="{ hidden: connected, disconnected: !connected }" aria-label="Login or sign up")
            svg(width="15" height="15" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true")
              use(href="/icons.svg#log-in")
            span Login / Signup
          button#disconnectWalletBtn.headerbar-wallet.hidden(:class="{ hidden: !connected, 'auth-required': showAuthRequired }" aria-label="Wallet menu")
            svg(width="15" height="15" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true")
              use(href="/icons.svg#wallet")
            span#disconnectWalletBtnText(x-text="label") Disconnect
      //- ═══════════════════════════════════════════════════════════
      //- Studio view
      //- ═══════════════════════════════════════════════════════════
      main#studioView.app-view
        .studio-layout
          //- Unified Sidebar with View Switcher
          aside.sidebar#sidebar
            .sidebar-switcher(role="tablist")
              button.sidebar-switcher-btn.active(data-view="chat" role="tab" aria-selected="true" tabindex="0" aria-label="AI Generation" title="AI Generation (Ctrl+1)")
                svg(width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true")
                  use(href="/icons.svg#sparkle")
              button.sidebar-switcher-btn(data-view="settings" role="tab" aria-selected="false" tabindex="-1" aria-label="Settings" title="Settings (Ctrl+2)")
                svg(width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true")
                  use(href="/icons.svg#settings")
              button.sidebar-switcher-btn(data-view="outline" role="tab" aria-selected="false" tabindex="-1" aria-label="Outline" title="Outline (Ctrl+3)")
                svg(width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true")
                  use(href="/icons.svg#crosshair")
              button.sidebar-switcher-btn(data-view="library" role="tab" aria-selected="false" tabindex="-1" aria-label="Gallery" title="Gallery (Ctrl+4)")
                svg(width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true")
                  use(href="/icons.svg#book")
              button.sidebar-switcher-btn(data-view="ledger" role="tab" aria-selected="false" tabindex="-1" aria-label="Activity" title="Activity (Ctrl+5)")
                svg(width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true")
                  use(href="/icons.svg#file-text")
              .sidebar-switcher-bottom
                button#sidebarToggle.panel-toggle(aria-label="Collapse sidebar" title="Toggle sidebar (Ctrl+B)" aria-expanded="true" aria-controls="sidebar")
                  svg(width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" aria-hidden="true")
                    use(href="/icons.svg#chevron-left")
            .sidebar-content
              //- View: Settings
              .sidebar-view(data-view="settings" hidden)
                .sidebar-view-header
                  h3 Settings
                .sidebar-view-body
                  #assetSettings
                    .form-group
                      label.form-label Asset Name
                      #assetNameDisplay.form-input Untitled Asset
                    .form-group
                      label.form-label(for="collectionSelect") Collection
                      select#collectionSelect.form-select
                        option(value="") Default
                    .form-group
                      label.form-label(for="tierSelect") Quality Tier
                      select#tierSelect.form-select(aria-describedby="tierHelp")
                        option(value="0" selected) Free — ~$0.0001 gas
                      .form-help#tierHelp Higher tiers produce better quality meshes.
                    #teamPanel.team-section(hidden)
                      .team-header
                        h5 Collection Collaborators
                        span.owner-badge Owner
                      .team-list
                      p.team-help Open this collection in the Library to add or remove collaborators.

              //- View: AI Generation (data-view kept as "chat" for selector stability)
              .sidebar-view(data-view="chat")
                .sidebar-view-header
                  h3 AI Generation
                  .outliner-toolbar
                    button#clearChatBtn.btn.btn-icon.btn-sm(type="button" aria-label="Clear chat" title="Clear chat — start new model")
                      svg(width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true")
                        use(href="/icons.svg#trash")
                .sidebar-view-body
                  #chatHistory
                    #chatHistoryList.chat-history-list
                      .chat-welcome
                        .welcome-icon ✦
                        p.welcome-text Create an asset
                        p.welcome-sub Describe the 3D asset you want to generate.
                  .chat-composer
                    details#composerSettings.composer-settings(open)
                      summary.composer-settings-summary Provider &amp; Quality
                      .composer-settings-body
                        .form-group
                          label.form-label(for="providerSelect") Generation Provider
                          .provider-row
                            select#providerSelect.form-select
                              option(value="mock") Mock (Local)
                              option(value="tripo3d") Tripo 3D
                            button#providerKeyBtn.provider-key-btn(type="button" hidden aria-label="Configure API key" title="Configure Tripo 3D API key")
                              svg(width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true")
                                use(href="/icons.svg#key")
                          p#providerKeyHint.provider-key-hint(hidden) API key required — select the key icon to add it.
                          p#providerBalance.provider-balance(hidden)
                          #textureQualityRow.form-group(hidden)
                            label.form-label(for="textureQualitySelect") Texture quality
                            select#textureQualitySelect.form-select
                              option(value="standard") Standard
                              option(value="detailed") Detailed (slower, more credits)
                              option(value="extreme") Extreme 8K (most credits)
                    //- Multiview attach chips (rendered by create-panel.js from the
                    //- attachedImages array, canonical view order front/left/back/right).
                    #imageAttachChips.image-attach-chips(hidden)
                    p#multiviewHint.messagebar-hint(hidden)
                    #refineIndicator.refine-indicator(hidden)
                      span#refineIndicatorText.refine-indicator-text
                      button#refineIndicatorDetach.refine-indicator-detach(type="button" aria-label="Detach — next prompt starts a new model") &times;
                    .messagebar-row
                      textarea#promptInput.messagebar-input(placeholder="Describe the 3D asset you envision…" rows="3" aria-label="Asset generation prompt")
                      input#imageAttachInput(type="file" accept="image/jpeg,image/png,image/webp" multiple hidden)
                      .messagebar-actions
                        button#imageAttachBtn.messagebar-attach(type="button" hidden aria-label="Attach image for image-to-3D" title="Attach reference image(s) — up to 4 views (Tripo 3D)")
                          svg(width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true")
                            use(href="/icons.svg#image")
                        button#generateBtn.messagebar-submit(aria-label="Generate asset")
                          svg.messagebar-submit-icon(width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" aria-hidden="true")
                            use(href="/icons.svg#send-arrow")
                          .messagebar-spinner
                    p#generateHint.messagebar-hint(hidden)
                      svg.messagebar-hint-icon(width="13" height="13" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true")
                        use(href="/icons.svg#lock")
                      span Sign in to start generating assets.

              //- View: Outline
              .sidebar-view(data-view="outline" hidden)
                .sidebar-view-header
                  h3 Outline
                  .outliner-toolbar
                    button#outlinerAddBtn.btn.btn-icon.btn-sm(aria-label="Add child asset" title="Add child asset")
                      svg(width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" aria-hidden="true")
                        use(href="/icons.svg#plus")
                    button#outlinerRemoveBtn.btn.btn-icon.btn-sm(aria-label="Remove selected" title="Remove selected")
                      svg(width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" aria-hidden="true")
                        use(href="/icons.svg#minus")
                .sidebar-view-body
                  .outliner
                    .outliner-tree
                    .outliner-footer No items

              //- View: Library
              .sidebar-view(data-view="library" hidden)
                .sidebar-view-header
                  h3 Gallery
                .sidebar-view-body
                  #assetLibraryBody.asset-library-body
                    .empty-state
                      .empty-state-icon
                        svg(width="22" height="22" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true")
                          use(href="/icons.svg#wallet")
                      h2.empty-state-title No assets yet
                      p.empty-state-sub Sign in to browse and open the asset tokens you own.
                      button#galleryConnectBtn.empty-state-action.btn.btn-primary.btn-sm(type="button") Login / Signup

              //- View: Ledger
              .sidebar-view(data-view="ledger" hidden)
                .sidebar-view-header
                  h3 Activity
                .sidebar-view-body
                  #ledgerBody.ledger-panel-body(x-data="ledgerPanel")
                    .ledger-panel-controls
                      select#ledgerFilter.ledger-filter(x-model="filter")
                        option(value="") All Operations
                        option(value="GENERATION") Generation
                        option(value="PARAMETRIC") Parametric
                        option(value="SAVE") Save
                        option(value="PUBLISH") Publish
                        option(value="THUMBNAIL") Thumbnail
                        option(value="MINT") Mint
                        option(value="TOKEN_URI_UPDATE") URI Update
                        option(value="TEAM_EDIT") Team Edit
                      button#ledgerAnchorBtn.ledger-anchor-btn(
                        title="Anchor current manifest CID on-chain for immutability proof"
                        @click="anchor()"
                      ) Anchor Manifest
                    #ledgerStats.ledger-stats(x-text="statsText")
                    ul#ledgerList.ledger-list
                      template(x-for="row in rows" :key="row.id")
                        li.ledger-entry
                          span.ledger-entry-icon(x-text="row.icon")
                          span.ledger-entry-type(:title="row.opType" x-text="row.label")
                          span.ledger-entry-cid(:title="row.cid" x-text="row.cidShort")
                          span.ledger-entry-actor(:title="row.actor" x-text="row.actorShort")
                          span.ledger-entry-time(x-text="row.timeText")
                      template(x-if="!rows.length")
                        li.ledger-empty No operations recorded yet.

            //- Drag handle to resize the sidebar (wide layouts only)
            #sidebarResizeHandle.sidebar-resize-handle(role="separator" aria-orientation="vertical" aria-label="Resize sidebar" title="Drag to resize · double-click to reset" tabindex="0")

          //- Sidebar reveal button
          button#sidebarReveal.sidebar-reveal(aria-label="Show sidebar" title="Show sidebar (Ctrl+B)")
            svg(width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" aria-hidden="true")
              use(href="/icons.svg#chevron-right")

          //- Main content area
          main#mainStage.main-stage
            #viewport.viewport
              canvas#renderCanvas(aria-label="3D viewport" role="img")
              canvas#viewportGizmo(aria-label="Viewport orientation gizmo" title="X Y Z orientation")

              #taskProgress.task-progress(hidden aria-hidden="true")
                span#taskProgressLabel.task-progress-label
                .task-progress-track
                  #taskProgressFill.task-progress-fill

              #assetDropOverlay.viewport-drop-indicator
                div(style="position:absolute;inset:0;display:flex;align-items:center;justify-content:center;color:var(--accent-bg);font-weight:600")
                  .asset-drop-icon ⊕
                  p Drop to add linked asset to scene

          //- Inspector — right sidebar (open by default; user collapses via toggle)
          aside#inspector.inspector
            .inspector-header
              h3 Properties
            .inspector-body
              section#tokenChildInfo.inspector-section.inspector-token-child(hidden)
                details
                  summary.inspector-section-title Token Info
                  div
                    .inspector-meta
                      .inspector-meta-row
                        span.label Linked Token
                        span#tokenChildId.value —
                      .inspector-meta-row
                        span.label Contract
                        span#tokenChildContract.value —
                      .inspector-meta-row
                        span.label Chain ID
                        span#tokenChildChain.value —
                      .inspector-meta-row
                        span.label Resolution
                        span#tokenChildResolution.value latest
                      .inspector-meta-row
                        span.label Manifest CID
                        span#tokenChildCid.value(style="font-family:var(--font-mono);font-size:var(--font-size-0);word-break:break-all") —
                    .inspector-actions
                      button#inspectorDiveBtn.btn.btn-primary(style="width:100%") Open Asset &rarr;
              section#scaleSection.inspector-section.inspector-scale(hidden)
                details
                  summary.inspector-section-title Scale
                  div
                    .inspector-transform
                      .inspector-transform-row
                        label(for="nodeScaleFactor") Factor
                        input#nodeScaleFactor.form-input(type="number" min="0.01" step="0.1" value="1" aria-label="Uniform scale factor")
                      .inspector-transform-row
                        label(for="nodeScalePercent") Percent
                        input#nodeScalePercent.form-input(type="number" min="1" step="1" value="100" aria-label="Uniform scale percentage")
                    p.inspector-hint Applies the same scale on all axes — enter the same value on each copy to make them identical in size.
              section#animationsSection.inspector-section.inspector-animations(hidden)
                details
                  summary.inspector-section-title Animations
                  div
                    select#animationSelect.form-select(aria-label="Animation clip")
                      option(value="") None
              section#parametricEditor.inspector-section
                details
                  summary.inspector-section-title Color
                  div
                    #componentEditor(hidden)
                      .component-editor-header
                        span#selectedComponentName.component-editor-name —
                        .component-editor-swatch#selectedComponentSwatch
                      input#selectedComponentColor.form-color.component-color-editor(type="color" aria-label="Component color")
              section#commentsSection.inspector-section.comments-section(hidden)
                h3#commentsTitle.inspector-section-title Comments ·
                  span#commentsCount 0
                .comments-scroll
                  ul#commentList.comment-list(role="list" aria-label="Comments")
                #commentsEmpty.comments-empty(hidden)
                  .comments-empty-icon ✦
                  p.comments-empty-title No comments yet
                  p.comments-empty-sub Mention an editor to request a change or review.
                .comment-composer
                  #commentAutocomplete.autocomplete(hidden role="listbox" aria-label="Mention a wallet")
                  label.composer-label(for="commentComposerInput") Add a comment
                  textarea#commentComposerInput.composer-input(rows="3" placeholder="Add a comment… use @ to mention a wallet." aria-label="Add a comment")
                  .composer-actions
                    span.composer-hint Ctrl+Enter to send
                    button#postCommentBtn.btn.btn-primary.btn-sm(type="button" aria-label="Post comment" title="Post comment (Ctrl+Enter)") Post
                span#commentsLiveRegion.sr-only(aria-live="polite" aria-atomic="true")
            .inspector-footer
              button#inspectorToggle.panel-toggle(aria-label="Collapse inspector" title="Collapse inspector" aria-expanded="true")
                svg(width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" aria-hidden="true")
                  use(href="/icons.svg#chevron-right")
          button#inspectorReveal.inspector-reveal(aria-label="Show inspector" title="Show inspector")
            svg(width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" aria-hidden="true")
              use(href="/icons.svg#chevron-left")
        footer#bottomBar.bottombar
          .bottombar-status
            span#bottomBarStatus.bottombar-status-item Draft
            span#bottomBarProvider.bottombar-status-item Provider: Mock (Local)
            span#bottomBarSelection.bottombar-status-item.bottombar-selection(hidden aria-live="polite")
            span#srStatus.sr-only(aria-live="polite" aria-atomic="true")
          button#keyboardHelpBtn.bottombar-help(type="button" aria-label="Keyboard shortcuts" title="Keyboard shortcuts (Ctrl+/)")
            | ?
      //- ═══════════════════════════════════════════════════════════
      //- Library view
      //- ═══════════════════════════════════════════════════════════
      main#libraryView.app-view.hidden
        .library-layout
          #libraryGate
            .empty-state
              .empty-state-icon
                svg(width="22" height="22" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true")
                  use(href="/icons.svg#wallet")
              h2.empty-state-title Sign in to continue
              p.empty-state-sub Sign in to browse your collections and assets.
              button#libraryConnectBtn.empty-state-action.btn.btn-primary.btn-sm(type="button") Login / Signup

          #libraryMain.hidden
            .library-toolbar
              button#libraryUpBtn.library-up-btn.btn.btn-secondary.btn-sm(type="button" aria-label="Up to collections" title="Up to collections" hidden)
                svg(width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true")
                  use(href="/icons.svg#chevron-up")
                span Up
              nav#libraryBreadcrumb.pathbar(aria-label="Collection path")
              input#librarySearchInput.form-input.library-search(type="search" placeholder="Search collections and assets…" aria-label="Search items")
              select#librarySortSelect.form-input.library-sort(aria-label="Sort by")
                option(value="name") Name
                option(value="date") Date
                option(value="status") Status
              .library-toolbar-actions
                button#libraryCreateCollectionBtn.btn.btn-secondary.btn-sm(type="button" hidden)
                  svg(width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true")
                    use(href="/icons.svg#folder-plus")
                  span New Collection
                button#libraryUploadBtn.btn.btn-primary.btn-sm(type="button" hidden)
                  svg(width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true")
                    use(href="/icons.svg#upload")
                  span Upload

            #libraryContent.library-content
              #libraryItems.library-grid(role="listbox" aria-multiselectable="true")

            .library-statusbar
              span#libraryItemCount.library-statusbar-count 0 items
              .library-view-toggle(role="group" aria-label="View mode")
                button#libraryGridViewBtn.active(type="button" data-view="grid" aria-label="Grid view" title="Grid view")
                  svg(width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true")
                    use(href="/icons.svg#grid")
                button#libraryListViewBtn(type="button" data-view="list" aria-label="List view" title="List view")
                  svg(width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true")
                    use(href="/icons.svg#list")

            #libraryLiveRegion.sr-only(aria-live="polite" aria-atomic="true")

          //- Upload progress (drop / Upload button) — same GNOME infobar
          //- component as the viewport's #taskProgress, rooted at this view.
          #libraryProgress.task-progress(hidden aria-hidden="true")
            span#libraryProgressLabel.task-progress-label
            .task-progress-track
              #libraryProgressFill.task-progress-fill

          //- OS file drop target — mirrors the viewport drop indicator; the
          //- label flips between upload affordance and the no-collection hint.
          #libraryDropOverlay.viewport-drop-indicator
            .library-drop-content
              .asset-drop-icon ⊕
              p#libraryDropText Drop to upload to this collection
        input#libraryUploadInput(type="file" accept=".glb,.gltf,.3mf" hidden)
      //- Wallet Popover (shared) — Alpine.js component, see js/ui/wallet-popover.js
      #walletPopover.wallet-popover.hidden(x-data="walletPopover" :class="{ hidden: !isOpen }" aria-label="Wallet menu")
        .wallet-popover-header
          span#walletPopoverAddress.wallet-popover-address(x-text="displayAddress" :title="address") —
          button#walletPopoverCopy.wallet-popover-copy(type="button" @click="copy()" x-text="copied ? 'Copied!' : 'Copy'" :class="{ copied }") Copy
        a#walletPopoverExplorer.wallet-popover-explorer.hidden(href="#" target="_blank" rel="noopener noreferrer" :href="explorerUrl || '#'" :class="{ hidden: !explorerUrl }")
          | View on Explorer
          svg(width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true")
            use(href="/icons.svg#external-link")
        .wallet-popover-actions
          button#walletPopoverSignIn.wallet-popover-signin.btn.btn-primary.btn-sm.hidden(type="button" @click="signIn()" :class="{ hidden: !showSignIn }") Sign In
          button#walletPopoverDisconnect.wallet-popover-disconnect.btn.btn-danger.btn-sm(type="button" @click="disconnect()") Log Out
    //- Shared modal dialog host — Alpine.js component, see js/ui/dialog.js.
    //- x-if (not x-show): a closed dialog is absent from the DOM entirely.
    #appDialogHost(x-data="dialog")
      template(x-if="open")
        .dialog-backdrop(@click.self="cancel()")
          .dialog(role="dialog" aria-modal="true" :aria-labelledby="titleId")
            .dialog-header
              h2.dialog-title(:id="titleId" x-text="title")
            template(x-if="kind === 'prompt'")
              .dialog-body
                p(style="margin:0 0 var(--size-2)" x-text="body")
                .form-group
                  input.dialog-input.form-input(type="text" autocomplete="off" :value="inputValue" @keydown.enter.prevent="confirm()" @keydown.escape.prevent="cancel()")
            template(x-if="kind === 'confirm'")
              .dialog-body
                p(style="margin:0" x-text="body")
            template(x-if="kind === 'info'")
              .dialog-body(x-html="bodyHtml")
            template(x-if="kind === 'checkbox'")
              .dialog-body
                p(style="margin:0 0 var(--size-2)" x-text="body")
                template(x-for="(opt, idx) in options" :key="idx")
                  label(style="display:flex;align-items:center;gap:var(--size-2);padding:var(--size-1) 0")
                    input(type="checkbox" :value="opt.value" :checked="opt.checked" @change="onOptionToggle(opt, $event)")
                    span(x-text="opt.label")
            template(x-if="kind === 'custom'")
              .dialog-body.collaborator-dialog-body
                #appDialogCustomBody
            template(x-if="kind === 'burn'")
              .dialog-body
                p.dialog-warning(style="margin:0 0 var(--size-2)") Burning collection will delete all assets unless it is part of besked collection
                p(style="margin:0 0 var(--size-2)") Type #[strong(x-text="collectionName")] to confirm.
                .form-group
                  input.dialog-input.form-input(type="text" autocomplete="off" :placeholder="placeholder" @input="onBurnInput($event.target.value)" @keydown.escape.prevent="cancel()" @keydown.enter="onBurnEnter($event)")
            template(x-if="kind === 'prompt'")
              .dialog-actions
                button.btn.btn-secondary.dialog-cancel-btn(type="button" @click="cancel()") Cancel
                button.btn.btn-primary.dialog-confirm-btn(type="button" @click="confirm()") Confirm
            template(x-if="kind === 'confirm'")
              .dialog-actions
                template(x-for="(btn, idx) in buttons" :key="idx")
                  button.dialog-action-btn(type="button" :class="btn.className" :data-value="btn.value" x-text="btn.text" @click="closeWithValue(btn.value)")
            template(x-if="kind === 'info' || kind === 'custom'")
              .dialog-actions
                button.btn.btn-primary.dialog-close-btn(type="button" @click="cancel()") Close
            template(x-if="kind === 'checkbox'")
              .dialog-actions
                button.btn.btn-secondary.dialog-action-btn(type="button" data-value="cancel" @click="cancel()") Cancel
                button.btn.btn-primary.dialog-confirm-btn(type="button" @click="confirmCheckbox()") Confirm
            template(x-if="kind === 'burn'")
              .dialog-actions
                button.btn.btn-secondary.dialog-cancel-btn(type="button" @click="cancel()") Cancel
                button.btn.btn-danger.dialog-burn-btn(type="button" :disabled="!burnEnabled" @click="closeWithValue('burn')") Burn Collection
