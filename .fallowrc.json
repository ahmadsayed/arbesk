{
  "$schema": "https://raw.githubusercontent.com/fallow-rs/fallow/main/schema.json",
  "entry": [
    "src/index.ts",
    // @arbesk/cad-gen's backend is a second process entry (the validation child
    // is spawned by path, never imported) plus the package subpath the server
    // imports. Same reasoning as the gltf worker entry below.
    "packages/cad-gen/src/backend/child.ts",
    "packages/cad-gen/src/backend/index.ts",
    "frontend/src/js/app-entry.ts",
    "frontend/src/js/app/initial-view.ts",
    "frontend/src/js/engine/theme-init.ts",
    // Landing page classic script: index.pug loads the built /js/landing/landing.js
    // by URL (bundle.js classic-scripts loop), which the import graph cannot see.
    "frontend/src/js/landing/landing.ts",
    "frontend/src/js/workers/gltf-worker.ts",
    // CAD render worker: same fixed-asset reasoning as the gltf worker entry
    // above — frontend/scripts/bundle.js references it by path string, which
    // the import graph cannot see.
    "frontend/src/js/workers/cad-worker.ts",
    "frontend/scripts/*.js",
    // render-scss.js compiles styles.scss by path; partials resolve via @use.
    "frontend/src/scss/styles.scss",
    "blockchain/hardhat.config.js",
    "blockchain/scripts/*.js",
    "scripts/*.mjs",
    "test/frontend/*.bench.mjs",
    // bun test preloads: test/bun.setup.js via bunfig.toml, test/helpers/dom.js
    // via scripts/run-tests.mjs --preload for `// @test-env dom` suites.
    // Neither is imported, so the graph cannot see them.
    "test/bun.setup.js",
    "test/helpers/dom.js",
    // Fixture generator run by hand (node e2e/fixtures/make-animated-glb.mjs).
    "e2e/fixtures/make-animated-glb.mjs"
  ],
  "ignorePatterns": [
    "frontend/src/js/vendor/**",
    "docs/diagrams/**"
  ],
  "ignoreExportsUsedInFile": false,
  "boundaries": {
    "zones": [
      {
        "name": "frontend-wallet-ipfs-leaf",
        "patterns": ["frontend/src/js/blockchain/**", "frontend/src/js/ipfs/**"]
      },
      {
        "name": "frontend-services-api",
        "patterns": ["frontend/src/js/services/api.ts"]
      }
    ],
    "rules": [
      { "from": "frontend-wallet-ipfs-leaf", "allow": [] }
    ]
  },
  "health": {
    "thresholdOverrides": [],
    // Tooling, not product. These are operator and developer entry points whose
    // functions are long but linear - a CLI main, a rasteriser inner loop, a
    // deploy script - which is exactly where cyclomatic and CRAP mislead. They
    // also carry no test coverage by design, and CRAP's coverage term assumes
    // tests that will never exist for them.
    "ignore": ["blockchain/scripts/**", "test/**", "scripts/**"]
  },
  "ignoreDependencies": [
    "@coinbase/cdp-core",
    "@nomicfoundation/hardhat-network-helpers",
    "@nomicfoundation/hardhat-toolbox",
    "@openzeppelin/hardhat-upgrades",
    "alpinejs",
    "autoprefixer",
    "chai",
    // blockchain/ is a standalone npm package (undeclared workspace) with
    // dotenv in its own package.json - fallow cannot see that manifest.
    "dotenv",
    "ethers",
    "hardhat",
    "istanbul-lib-coverage",
    "istanbul-lib-report",
    "istanbul-reports",
    "postcss",
    "prettier",
    "pug",
    "sass",
    "viem",
    "workerpool"
  ],
  "ignoreExports": [
    {
      "file": "packages/asset-core/src/domain/editors.ts",
      "exports": ["EditorEntry", "MAX_EDITORS_PER_TOKEN", "computeRoot", "getProof", "makeLeaf", "clearEditorCache"]
    },
    {
      "file": "packages/wallet/src/merkle.ts",
      "exports": ["EditorEntry", "MAX_EDITORS_PER_TOKEN", "computeRoot", "getProof", "makeLeaf"]
    },
    {
      "file": "frontend/src/js/state/library-state.ts",
      "exports": ["_resetForTesting"]
    },
    {
      "file": "frontend/src/js/state/wallet-state.ts",
      "exports": ["_resetForTesting"]
    },
    {
      "file": "packages/asset-core/src/domain/asset-store.ts",
      "exports": ["_resetForTesting"]
    },
    {
      "file": "packages/asset-core/src/formats/gltf/decomposer.ts",
      "exports": ["decompose"]
    },
    {
      "file": "packages/asset-core/src/formats/gltf/glb-parser.ts",
      "exports": ["decompose"]
    },
    {
      "file": "packages/asset-core/src/catalog/index.ts",
      "exports": ["getCollectionAssets", "listCollections", "resolveAssetByName", "resolveCollectionByName"]
    },
    {
      "file": "packages/besk/src/catalog.ts",
      "exports": ["getCollectionAssets", "listCollections", "resolveAssetByName", "resolveCollectionByName"]
    },

    // Test-only public surface: consumed via dynamic import() in test specs
    // (fallow's syntactic graph cannot resolve dynamic imports).
    {
      "file": "frontend/src/js/services/chat-preview.ts",
      "exports": ["getChatPreview"]
    },
    {
      "file": "frontend/src/js/ui/ledger-panel.ts",
      "exports": ["refreshLedger"]
    },
    {
      "file": "src/api/authz.ts",
      "exports": ["createAuthzInstance"]
    },
    {
      "file": "frontend/src/js/blockchain/wallet-core.ts",
      "exports": ["autoConnectWallet"]
    },
    {
      "file": "frontend/src/js/blockchain/wallet-gas.ts",
      "exports": ["SMART_ACCOUNT_GAS_LIMIT"]
    },
    {
      "file": "frontend/src/js/engine/babylon-loader.ts",
      "exports": ["registerGltfLoaderDefaults"]
    },
    {
      "file": "frontend/src/js/engine/cleanup.ts",
      "exports": ["disposeNode"]
    },
    {
      "file": "frontend/src/js/engine/parametric-preview.ts",
      "exports": ["openInspector"]
    },
    {
      "file": "frontend/src/js/engine/version-history-deps.ts",
      "exports": ["assetCidFromTokenUriManifest"]
    },
    {
      "file": "frontend/src/js/services/asset-download.ts",
      "exports": ["downloadAssetByManifestCid"]
    },
    {
      "file": "frontend/src/js/ui/create-panel.ts",
      "exports": ["isRealProvider", "shouldUseStoppable", "generationErrorMessage"]
    },
    {
      "file": "frontend/src/js/ui/chat-messages.ts",
      "exports": ["chatFeed"]
    },
    {
      "file": "frontend/src/js/services/nostr-config.ts",
      "exports": ["NOSTR_RELAY_URL"]
    },
    {
      "file": "frontend/src/js/ui/nesting.ts",
      "exports": ["ascendOneLevel"]
    },
    {
      "file": "frontend/src/js/ui/outline-parts.ts",
      "exports": ["partLabel"]
    },
    {
      "file": "frontend/src/js/ui/testnet-banner.ts",
      "exports": ["initTestnetBanner", "initNetworkStatus"]
    },
    {
      "file": "packages/asset-core/src/formats/gltf/merkle-editors.ts",
      "exports": ["verifyProof"]
    },

    // Alternative Playwright fixtures (plain vs coverage-tracking); each spec
    // imports one, so the shared `test` name is intentional.
    {
      "file": "e2e/fixtures/coverage.mjs",
      "exports": ["test"]
    },
    {
      "file": "e2e/fixtures/test.mjs",
      "exports": ["test"]
    },

    // Two distinct functions share this name: network-config (sync, per-chain
    // lookup) vs backend-client (async, fetches /config). Intentional overlap.
    {
      "file": "frontend/src/js/blockchain/network-config.ts",
      "exports": ["getContractAddress"]
    },
    {
      "file": "frontend/src/js/services/backend-client.ts",
      "exports": ["getContractAddress"]
    }
  ]
}
