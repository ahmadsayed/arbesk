{
  "$schema": "https://raw.githubusercontent.com/fallow-rs/fallow/main/schema.json",
  "entry": [
    "src/index.ts",
    "frontend/src/js/app-init.ts",
    "frontend/src/js/app/initial-view.ts",
    "frontend/src/js/blockchain/token-resolver.ts",
    "frontend/src/js/blockchain/wallet.ts",
    "frontend/src/js/engine/animation-preview.ts",
    "frontend/src/js/engine/parametric-preview.ts",
    "frontend/src/js/engine/scene-graph.ts",
    "frontend/src/js/engine/theme-init.ts",
    "frontend/src/js/engine/time-travel.ts",
    "frontend/src/js/services/api.ts",
    "frontend/src/js/services/asset-file-drop.ts",
    "frontend/src/js/services/team.ts",
    "frontend/src/js/ui/asset-chrome.ts",
    "frontend/src/js/ui/asset-drop-zone.ts",
    "frontend/src/js/ui/asset-save.ts",
    "frontend/src/js/ui/collaborators.ts",
    "frontend/src/js/ui/comments-panel.ts",
    "frontend/src/js/ui/create-panel.ts",
    "frontend/src/js/ui/nesting.ts",
    "frontend/src/js/ui/outliner.ts",
    "frontend/src/js/ui/scene-clock.ts",
    "frontend/src/js/ui/sidebar.ts",
    "frontend/src/js/ui/toasts.ts",
    "frontend/src/js/ui/wallet-popover.ts",
    "frontend/src/js/workers/gltf-worker.ts",
    "frontend/scripts/*.js",
    "frontend/src/scss/**/*.scss",
    "blockchain/hardhat.config.js",
    "blockchain/scripts/*.js",
    "scripts/*.mjs",
    "test/frontend/*.bench.mjs"
  ],
  "ignorePatterns": [
    "frontend/src/js/vendor/**",
    "e2e/**",
    "docs/diagrams/**"
  ],
  "boundaries": {
    "zones": [
      {
        "name": "frontend-wallet-ipfs-leaf",
        "patterns": ["frontend/src/js/blockchain/**", "frontend/src/js/ipfs/**"]
      },
      {
        "name": "frontend-services-api",
        "patterns": ["frontend/src/js/services/api.ts"]
      }
    ],
    "rules": [
      { "from": "frontend-wallet-ipfs-leaf", "allow": [] }
    ]
  },
  "health": {
    "thresholdOverrides": [],
    "ignore": ["blockchain/scripts/**", "test/**"]
  },
  "ignoreDependencies": [
    "@coinbase/cdp-core",
    "@nomicfoundation/hardhat-toolbox",
    "alpinejs",
    "autoprefixer",
    "chai",
    "ethers",
    "hardhat",
    "istanbul-lib-coverage",
    "istanbul-lib-report",
    "istanbul-reports",
    "postcss",
    "prettier",
    "pug",
    "sass",
    "shelljs",
    "upath",
    "v8-to-istanbul",
    "viem",
    "workerpool"
  ],
  "ignoreExports": [
    {
      "file": "packages/asset-core/src/domain/editors.ts",
      "exports": ["EditorEntry", "MAX_EDITORS_PER_TOKEN", "computeRoot", "getProof", "makeLeaf"]
    },
    {
      "file": "packages/wallet/src/merkle.ts",
      "exports": ["EditorEntry", "MAX_EDITORS_PER_TOKEN", "computeRoot", "getProof", "makeLeaf"]
    },
    {
      "file": "frontend/src/js/state/library-state.ts",
      "exports": ["_resetForTesting"]
    },
    {
      "file": "frontend/src/js/state/wallet-state.ts",
      "exports": ["_resetForTesting"]
    },
    {
      "file": "packages/asset-core/src/domain/asset-store.ts",
      "exports": ["_resetForTesting"]
    },
    {
      "file": "packages/asset-core/src/formats/gltf/decomposer.ts",
      "exports": ["decompose"]
    },
    {
      "file": "packages/asset-core/src/formats/gltf/glb-parser.ts",
      "exports": ["decompose"]
    },
    {
      "file": "packages/asset-core/src/catalog/index.ts",
      "exports": ["getCollectionAssets", "listCollections", "resolveAssetByName", "resolveCollectionByName"]
    },
    {
      "file": "packages/besk/src/catalog.ts",
      "exports": ["getCollectionAssets", "listCollections", "resolveAssetByName", "resolveCollectionByName"]
    }
  ]
}
