{
  "$schema": "https://raw.githubusercontent.com/fallow-rs/fallow/main/schema.json",
  "entry": [
    "src/index.ts",
    "frontend/src/js/app-entry.ts",
    "frontend/src/js/app/initial-view.ts",
    "frontend/src/js/engine/theme-init.ts",
    "frontend/src/js/workers/gltf-worker.ts",
    "frontend/scripts/*.js",
    "frontend/src/scss/**/*.scss",
    "blockchain/hardhat.config.js",
    "blockchain/scripts/*.js",
    "scripts/*.mjs",
    "test/frontend/*.bench.mjs"
  ],
  "ignorePatterns": [
    "frontend/src/js/vendor/**",
    "e2e/**",
    "docs/diagrams/**"
  ],
  "ignoreExportsUsedInFile": true,
  "publicPackages": [
    "@arbesk/asset-core",
    "@arbesk/wallet",
    "@arbesk/authz",
    "@arbesk/ai-asset-gen"
  ],
  "boundaries": {
    "zones": [
      {
        "name": "frontend-wallet-ipfs-leaf",
        "patterns": ["frontend/src/js/blockchain/**", "frontend/src/js/ipfs/**"]
      },
      {
        "name": "frontend-services-api",
        "patterns": ["frontend/src/js/services/api.ts"]
      }
    ],
    "rules": [
      { "from": "frontend-wallet-ipfs-leaf", "allow": [] }
    ]
  },
  "health": {
    "thresholdOverrides": [],
    "ignore": ["blockchain/scripts/**", "test/**"]
  },
  "ignoreDependencies": [
    "@coinbase/cdp-core",
    "@nomicfoundation/hardhat-network-helpers",
    "@nomicfoundation/hardhat-toolbox",
    "@openzeppelin/hardhat-upgrades",
    "alpinejs",
    "autoprefixer",
    "chai",
    "esbuild",
    "ethers",
    "hardhat",
    "istanbul-lib-coverage",
    "istanbul-lib-report",
    "istanbul-reports",
    "postcss",
    "prettier",
    "pug",
    "sass",
    "shelljs",
    "upath",
    "v8-to-istanbul",
    "viem",
    "workerpool"
  ],
  "ignoreExports": [
    {
      "file": "packages/asset-core/src/domain/editors.ts",
      "exports": ["EditorEntry", "MAX_EDITORS_PER_TOKEN", "computeRoot", "getProof", "makeLeaf"]
    },
    {
      "file": "packages/wallet/src/merkle.ts",
      "exports": ["EditorEntry", "MAX_EDITORS_PER_TOKEN", "computeRoot", "getProof", "makeLeaf"]
    },
    {
      "file": "frontend/src/js/state/library-state.ts",
      "exports": ["_resetForTesting"]
    },
    {
      "file": "frontend/src/js/state/wallet-state.ts",
      "exports": ["_resetForTesting"]
    },
    {
      "file": "packages/asset-core/src/domain/asset-store.ts",
      "exports": ["_resetForTesting"]
    },
    {
      "file": "packages/asset-core/src/formats/gltf/decomposer.ts",
      "exports": ["decompose"]
    },
    {
      "file": "packages/asset-core/src/formats/gltf/glb-parser.ts",
      "exports": ["decompose"]
    },
    {
      "file": "packages/asset-core/src/catalog/index.ts",
      "exports": ["getCollectionAssets", "listCollections", "resolveAssetByName", "resolveCollectionByName"]
    },
    {
      "file": "packages/besk/src/catalog.ts",
      "exports": ["getCollectionAssets", "listCollections", "resolveAssetByName", "resolveCollectionByName"]
    },

    // Backward-compat re-export barrels / modules (scene-graph re-export block,
    // wallet.ts barrel, token-resolver + create-panel re-exports): the names are
    // consumed via their canonical modules, so the re-exports read as unused.
    {
      "file": "frontend/src/js/blockchain/wallet.ts",
      "exports": ["autoConnectWallet", "authenticateUser", "getActiveConnectionSource", "NETWORKS", "web3Provider", "payForGenerationWithUSDC", "recordGeneration", "isFreeTierContract", "walletContract"]
    },
    {
      "file": "frontend/src/js/engine/scene-graph.ts",
      "exports": ["DEFAULT_WOOD_COLOR", "MAX_CHILD_ASSET_DEPTH", "extractCid", "detectAssetFormat", "getManifestNodes", "applyTransformMatrix", "applyDefaultMaterial", "getRenderableMeshes", "getWorldBounds", "centerImportedAsset", "createPlaceholder", "disposePlaceholder", "disposeNode", "disposeNodeContent", "disposeNodeSubtree", "clearPendingPostProcessorEdit", "clearPendingTransformEdit", "stagePendingSourceOverride", "clearPendingSourceOverride", "loadNode", "loadAsset", "replaceRootModelSource", "createRootDraftSource", "getNodeAnchor"]
    },
    {
      "file": "frontend/src/js/engine/transforms.ts",
      "exports": ["detectAssetFormat"]
    },
    {
      "file": "frontend/src/js/engine/cleanup.ts",
      "exports": ["clearPendingSourceOverride"]
    },
    {
      "file": "frontend/src/js/blockchain/token-resolver.ts",
      "exports": ["normalizeTokenURI"]
    },
    {
      "file": "frontend/src/js/ui/create-panel.ts",
      "exports": ["addChatMessage"]
    },

    // Test-only public surface: consumed via dynamic import() in Jest specs
    // (fallow's syntactic graph cannot resolve dynamic imports).
    {
      "file": "frontend/src/js/services/chat-preview.ts",
      "exports": ["getChatPreview"]
    },
    {
      "file": "frontend/src/js/ui/ledger-panel.ts",
      "exports": ["refreshLedger"]
    },
    {
      "file": "src/api/authz.ts",
      "exports": ["createAuthzInstance"]
    },

    // Re-exported types from the API client barrel (type-only consumers).
    {
      "file": "frontend/src/js/services/api.ts",
      "exports": ["CachedSession", "UploadCredential", "UnpinTokenContext"]
    },

    // Two distinct functions share this name: network-config (sync, per-chain
    // lookup) vs backend-client (async, fetches /config). Intentional overlap.
    {
      "file": "frontend/src/js/blockchain/network-config.ts",
      "exports": ["getContractAddress"]
    },
    {
      "file": "frontend/src/js/services/backend-client.ts",
      "exports": ["getContractAddress"]
    }
  ]
}
