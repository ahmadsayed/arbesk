{
  "name": "@arbesk/blockchain",
  "version": "0.1.0",
  "description": "Arbesk Solidity smart contracts (Hardhat)",
  "scripts": {
    "build": "hardhat compile",
    "test": "hardhat test",
    "test:trace": "hardhat test --trace",
    "test:mutation": "./scripts/mutation-test.sh",
    "coverage": "hardhat coverage",
    "deploy:local": "hardhat run scripts/deploy.js --network hardhat",
    "deploy:baseSepolia": "hardhat run scripts/deploy.js --network baseSepolia"
  },
  "devDependencies": {
    "@nomicfoundation/hardhat-toolbox": "^5.0.0",
    "@openzeppelin/contracts": "5.1.0",
    "@openzeppelin/hardhat-upgrades": "^3.9.1",
    "@openzeppelin/merkle-tree": "^1.0.8",
    "dotenv": "^16.4.0",
    "hardhat": "^2.22.0"
  },
  "dependencies": {
    "@openzeppelin/contracts-upgradeable": "5.1.0"
  }
}
