# Smart contract addresses (sync from blockchain/.env after deploy)
CONTRACT_ADDRESS=
PAID_CONTRACT_ADDRESS=
USDC_TOKEN=
BASE_CONTRACT_ADDRESS=

# IPFS storage backend: "pinata" (dev/prod) or "kubo" (automated E2E only)
IPFS_BACKEND=kubo

# Kubo settings (used when IPFS_BACKEND=kubo)
IPFS_API_URL=http://127.0.0.1:5001
IPFS_GATEWAY_URL=http://127.0.0.1:8080/ipfs/

# Pinata settings (used when IPFS_BACKEND=pinata)
# PINATA_JWT is server-only — never expose it to the browser.
PINATA_JWT=
PINATA_GATEWAY=your-gateway.mypinata.cloud
PINATA_UPLOAD_TTL=60

# Pre-minted credential pool (hides Pinata's /files/sign latency from the
# upload-url request path). 0 disables pooling. PINATA_UPLOAD_TTL must
# comfortably exceed PINATA_POOL_EXPIRY_MARGIN or pooled credentials expire
# before they can be served — see arbesk-ipfs-storage skill, Pinata Mode §7.
PINATA_POOL_SIZE=20
PINATA_POOL_EXPIRY_MARGIN=60

# Nostr relay used by the chat proxy
NOSTR_RELAY_URL=ws://127.0.0.1:7777

# Browser-facing Nostr relay URL served via /api/v1/config (k3s deployment:
# the relay is proxied through the ingress, e.g. wss://promptscad.com/nostr).
# Unset → browsers derive ws(s)://<app-hostname>:7777 (local dev).
PUBLIC_NOSTR_URL=

# Public origin of the deployment (e.g. https://promptscad.com) — adds the
# origin and its ws(s) equivalent to the CSP connect-src. Unset for local dev.
PUBLIC_ORIGIN=

# Nostr service private key (32-byte hex) used by the chat proxy to sign events.
# Generate with: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
NOSTR_SERVICE_PRIVATE_KEY=

# Local dev
HARDHAT_RPC_URL=http://127.0.0.1:8545
MOCK_3D_GENERATION=true

# Tripo3D model version used by the backend adapter (v3 API). Default: v3.1-20260211
TRIPO_3D_MODEL=v3.1-20260211

# Tripo3D rigging model version (animations/rig has its own model line;
# its default is rejected upstream). Allowed: v1.0-20240301, v2.5-20260210
TRIPO_3D_RIG_MODEL=v2.5-20260210

# Tripo3D rigging model for bipeds (humanoids) — tried first, falls back to
# TRIPO_3D_RIG_MODEL when Tripo rejects it (code 1004). v1.0 biped rigs take
# preset:biped:* retarget animation IDs; the adapter maps presets accordingly.
TRIPO_3D_RIG_BIPED_MODEL=v1.0-20240301

# Tripo3D API key for local manual/integration testing only.
# The production UI uses BYOK (providerKey) per request; the backend never reads this key.
TRIPO_3D_KEY=

# ─── CDP / Base (email login + gasless) ───
# CDP Project ID — public, served to the frontend via /api/v1/config
CDP_PROJECT_ID=

# CDP Paymaster RPC URL — secret, never served to the frontend
# Contains an embedded API key. Backend proxies paymaster calls via /api/v1/paymaster
CDP_PAYMASTER_URL=

# CDP Server API key (ID + secret) — used by the backend for server-side wallet
# operations (email→address resolution, email-login wallet provisioning).
# From the CDP Portal → API keys.
CDP_API_KEY_ID=
CDP_API_KEY_SECRET=

# CDP Wallet Secret — signs wallet-scoped POST/DELETE (createEndUser, smart accounts).
# REQUIRED for email-login wallet provisioning. From the CDP Portal → API keys.
CDP_WALLET_SECRET=

# Reserved for future E2E mock support: when set to true, a special OTP code
# ("000000") would bypass real CDP email verification and create a wallet at
# a known test address. Not implemented yet — placeholder only.
CDP_EMAIL_DEV_MODE=

# Optional
# Override generation rate limit (default: 10 in production, 1000 when MOCK_3D_GENERATION=true)
GENERATION_RATE_LIMIT_MAX=
# Override upload credential rate limit (default: 20 per 60s wallet-keyed)
UPLOAD_URL_RATE_LIMIT_MAX=
# Override unpin rate limit (default: 30 per 60s wallet-keyed)
UNPIN_RATE_LIMIT_MAX=
# Override GC rate limit (default: 10 per hour wallet-keyed)
GC_RATE_LIMIT_MAX=
# Override paymaster proxy rate limit (default: 30 per minute wallet-keyed)
PAYMASTER_RATE_LIMIT_MAX=
# Admin token required to run IPFS GC via POST /api/v1/ipfs/gc
GC_ADMIN_TOKEN=
# Kill-switch: any non-empty value drops Base Sepolia from NETWORK_CONFIGS
# so the backend/indexer stays local-only
INDEXER_DISABLE_TESTNET=

# ─── Engineering CAD generation (POST /api/v1/cad/*) ───
# Server-only. The server generates Manifold JS and runs the STATIC gates; the
# CLIENT runs the kernel, the geometry gates and the export. Unset → every CAD
# request is a 503 CAD_NOT_CONFIGURED.
DEEPSEEK_API_KEY=
DEEPSEEK_BASE_URL=https://api.deepseek.com
DEEPSEEK_MODEL=deepseek-flash
# Thinking mode is OFF by default: it costs latency and buys nothing for
# well-specified parts (measured — see the spike results).
CAD_THINKING=
# '' or unset → enabled whenever DEEPSEEK_API_KEY is present. Set false/0/no for
# the kill switch (503).
CAD_GENERATION_ENABLED=
# Static repair rounds inside one request. Also caps a client's repairAttempts.
CAD_MAX_REPAIR_ATTEMPTS=3
# ROUNDS per wallet per UTC day, NOT generations. Both /generations and /repairs
# cost one unit each, because each is one paid DeepSeek call. A part needing two
# client-driven repairs therefore spends three. Persisted in .data/cad-quota.json.
# (Replaces the old CAD_EXEC_TIMEOUT_MS / CAD_MAX_TRIANGLES — there is no
# server-side kernel to time out or to bound.)
CAD_DAILY_REQUEST_LIMIT=50
# Largest decoded attachment, checked BEFORE the wallet is charged (413).
CAD_MAX_IMAGE_BYTES=8388608
# Override the in-flight lock TTL. Default is DERIVED, not fixed:
# CAD_MAX_REPAIR_ATTEMPTS x 120000 + 30000 = 390000 ms.
CAD_MAX_REQUEST_MS=
# Override the hourly CAD limiter (default: 20 per hour, wallet-keyed)
CAD_RATE_LIMIT_MAX=
