{
  "name": "@arbesk/ai-asset-gen",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "Arbesk 3D-model generation SDK: a capability-gated facade over the mock, Tripo3D and CAD (design-on-the-wire) providers. Backend-only.",
  "sideEffects": false,
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": "./dist/index.js",
    "./*": "./dist/*"
  },
  "files": ["dist"],
  "scripts": {
    "build": "bun run clean && tsgo -p tsconfig.build.json",
    "clean": "bun -e \"fs.rmSync('dist', { recursive: true, force: true })\"",
    "typecheck": "bun check"
  },
  "dependencies": {
    "@arbesk/cad-gen": "*"
  },
  "license": "ISC"
}
