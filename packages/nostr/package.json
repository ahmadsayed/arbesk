{
  "name": "@arbesk/nostr",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "Environment-agnostic Arbesk Nostr SDK: wallet↔Nostr identity binding, asset-update event signing/publishing/verification. One TypeScript codebase consumed by the browser, the CLI, and tests.",
  "sideEffects": false,
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": "./dist/index.js",
    "./*": "./dist/*"
  },
  "files": ["dist"],
  "scripts": {
    "build": "bun run clean && tsgo -p tsconfig.build.json",
    "clean": "bun -e \"fs.rmSync('dist', { recursive: true, force: true })\"",
    "typecheck": "bun check"
  },
  "dependencies": {
    "nostr-tools": "^2.23.5",
    "viem": "catalog:"
  },
  "license": "ISC"
}
